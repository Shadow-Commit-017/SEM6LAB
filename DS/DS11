#mapper.py

import sys

for line in sys.stdin:
    parts = line.strip().split()

    if len(parts) >= 3:
        log_level = parts[2]

        # Emit key-value pair
        print(f"{log_level}\t1")


#reducer.py

import sys

current_key = None
current_count = 0

for line in sys.stdin:
    key, value = line.strip().split("\t")
    value = int(value)

    if key == current_key:
        current_count += value
    else:
        if current_key:
            print(f"{current_key}\t{current_count}")

        current_key = key
        current_count = value

# Print final key
if current_key:
    print(f"{current_key}\t{current_count}")


